                    head.Size = Vector3.new(2, 1, 1)
                end
            end
        end
    end
end)

-- Draggable
local tbDragging, tbDragInput, tbDragStart, tbStartPos
TbotLabelFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        tbDragging = true
        tbDragStart = input.Position
        tbStartPos = TbotLabelFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then tbDragging = false end
        end)
    end
end)
TbotLabelFrame.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        tbDragInput = input
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if input == tbDragInput and tbDragging then
        local delta = input.Position - tbDragStart
        TbotLabelFrame.Position = UDim2.new(tbStartPos.X.Scale, tbStartPos.X.Offset + delta.X, tbStartPos.Y.Scale, tbStartPos.Y.Offset + delta.Y)
    end
end)

