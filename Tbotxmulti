-- Click Event para mag-on/off
TbotLabelFrame.MouseButton1Click:Connect(function()
    tbotEnabled = not tbotEnabled
    hitboxEnabled = tbotEnabled
    
    if tbotEnabled then
        TbotLabelFrame.Text = "TBOT: ON"
        TbotLabelFrame.TextColor3 = Color3.fromRGB(50, 255, 50)
        applyHitboxToAll()
    else
        TbotLabelFrame.Text = "TBOT: OFF"
        TbotLabelFrame.TextColor3 = Color3.fromRGB(255, 40, 40)
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local head = p.Character:FindFirstChild("Head")
