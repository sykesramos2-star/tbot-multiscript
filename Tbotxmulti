-- NAVIGATION
local function switchTab(titleText, subText, content)
    ContentTitle.Text = titleText
    ContentSub.Text = subText
    for _, tab in pairs({ScriptsTab, OtherTab, SettingsTab}) do
        if tab ~= content then tab.Visible = false end
    end
    content.Visible = true
end

local function createNavButton(text, yPos, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -20, 0, 30) 
    btn.Position = UDim2.new(0, 10, 0, yPos)
    btn.BackgroundTransparency = 1 
    btn.Text = "   " .. string.upper(text)
    btn.TextColor3 = textDim
    btn.Font = mainFont
    btn.TextSize = 18
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.Parent = Sidebar
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)
    
    local isActive = false
    btn.MouseEnter:Connect(function()
        if not isActive then TweenService:Create(btn, hoverTweenInfo, {TextColor3 = textColor}):Play() end
    end)
    btn.MouseLeave:Connect(function()
        if not isActive then TweenService:Create(btn, hoverTweenInfo, {TextColor3 = textDim}):Play() end
    end)
    
    btn.MouseButton1Click:Connect(function()
        for _, child in pairs(Sidebar:GetChildren()) do
            if child:IsA("TextButton") then child.TextColor3 = textDim end
        end
        isActive = true
        TweenService:Create(btn, hoverTweenInfo, {TextColor3 = textColor}):Play()
        callback()
    end)
    return btn
end

