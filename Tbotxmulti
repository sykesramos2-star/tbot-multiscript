local hitboxSize = 15 -- Lakihan onti

-- Hitbox Updater
local function updateHitbox(char)
    if not char then return end
    local head = char:FindFirstChild("Head")
    if head then
        if hitboxEnabled then
            head.Size = Vector3.new(hitboxSize, hitboxSize, hitboxSize)
            head.Transparency = 1
            head.CanCollide = false
            head.Massless = true
        else
            head.Size = Vector3.new(2, 1, 1)
        end
    end
end

local function applyHitboxToAll()
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            updateHitbox(p.Character)
        end
    end
end

-- Auto-apply hitbox pag nag-respawn (para hindi lumiit)
Players.PlayerAdded:Connect(function(p)
    p.CharacterAdded:Connect(function(char)
        task.wait(1) -- Wait para mag-load yung character
        updateHitbox(char)
    end)
end)

-- Para sa mga players na nasa laro na bago pa na-on yung script
for _, p in pairs(Players:GetPlayers()) do
    if p ~= LocalPlayer then
        p.CharacterAdded:Connect(function(char)
            task.wait(1)
            updateHitbox(char)
        end)
        if p.Character then
            updateHitbox(p.Character)
        end
    end
end

