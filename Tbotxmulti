-- OTHER TAB CONTENT
local isFlying = false
createActionButton(OtherTab, "TOGGLE FLY", 0, function()
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChild("Humanoid")
    if not hrp or not hum then return end
    
    isFlying = not isFlying
    if isFlying then
        hum.PlatformStand = true
        local bv = Instance.new("BodyVelocity", hrp)
        bv.Name = "FlyVel"
        bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        bv.Velocity = Vector3.zero
        RunService.RenderStepped:Connect(function()
            if not bv.Parent then return end
            bv.Velocity = hum.MoveDirection * 50 + Vector3.new(0, (UserInputService:IsKeyDown(Enum.KeyCode.Space) and 50 or 0) - (UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) and 50 or 0), 0)
        end)
    else
        hum.PlatformStand = false
        local bv = hrp:FindFirstChild("FlyVel")
        if bv then bv:Destroy() end
    end
end)

local doubleJumpEnabled = false
local jumpsLeft = 2
createActionButton(OtherTab, "DOUBLE JUMP", 50, function()
    doubleJumpEnabled = not doubleJumpEnabled
end)

LocalPlayer.CharacterAdded:Connect(function(char)
    local humanoid = char:WaitForChild("Humanoid")
    jumpsLeft = 2
    humanoid.StateChanged:Connect(function(old, new)
        if new == Enum.HumanoidStateType.Landed or new == Enum.HumanoidStateType.Running then
            jumpsLeft = 2
        end
    end)
end)

UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if doubleJumpEnabled and (input.KeyCode == Enum.KeyCode.Space or input.UserInputType == Enum.UserInputType.Touch) then
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("Humanoid") and char:FindFirstChild("HumanoidRootPart") then
            local hum = char.Humanoid
            local hrp = char.HumanoidRootPart
            if hum:GetState() == Enum.HumanoidStateType.Freefall or hum:GetState() == Enum.HumanoidStateType.Jumping then
                if jumpsLeft > 0 then
                    jumpsLeft = jumpsLeft - 1
                    hrp.Velocity = Vector3.new(hrp.Velocity.X, hum.JumpPower, hrp.Velocity.Z)
                end
            end
        end
    end
end)

